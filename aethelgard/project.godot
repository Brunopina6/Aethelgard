; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Aethelgard"
run/main_scene="res://carga.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
run/main_scene.prueba3d="res://prototipos/sendero_puente.tscn"

[autoload]

Dialogic="*uid://ds2q0uclmolvu"
BotonDialogo="*res://boton_dialogo.gd"
Recursos="*res://recursos.gd"
Entrada="*res://entrada.gd"
Sonido="*res://sonido.gd"
Musica="*res://musica.gd"

[dialogic]

audio/type_sound_bus="Interfaz"
directories/dch_directory={
"aldric": "res://dialogos/personajes/aldric.dch",
"garon": "res://dialogos/personajes/garon.dch",
"kael": "res://dialogos/personajes/kael.dch",
"lya": "res://dialogos/personajes/lya.dch",
"pip": "res://dialogos/personajes/pip.dch",
"rosa": "res://dialogos/personajes/rosa.dch",
"selene": "res://dialogos/personajes/selene.dch",
"tilo": "res://dialogos/personajes/tilo.dch"
}
directories/dtl_directory={
"npc_aldric": "res://dialogos/npc_aldric.dtl",
"npc_pip": "res://dialogos/npc_pip.dtl",
"npc_rosa": "res://dialogos/npc_rosa.dtl",
"npc_selene": "res://dialogos/npc_selene.dtl",
"prologo": "res://dialogos/prologo.dtl",
"pv_02": "res://dialogos/pv_02.dtl",
"pv_03": "res://dialogos/pv_03.dtl",
"pv_05": "res://dialogos/pv_05.dtl",
"pv_06": "res://dialogos/pv_06.dtl",
"pv_07": "res://dialogos/pv_07.dtl",
"pv_14": "res://dialogos/pv_14.dtl",
"pv_tilo": "res://dialogos/pv_tilo.dtl",
"pv_tilo_fin": "res://dialogos/pv_tilo_fin.dtl"
}
layout/end_behaviour=1
layout/style_directory={}

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg", "res://addons/posador/plugin.cfg")

